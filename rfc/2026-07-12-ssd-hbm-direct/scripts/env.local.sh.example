# Copy to env.local.sh and fill in. Do NOT commit env.local.sh with secrets.

# Isolated verify on xqyun (NOT tiantiyun — avoid colliding with other jobs)
export L1_HOST="${L1_HOST:-xqyun-32c32g}"
export L1_REPO="${L1_REPO:-/root/workspace/git-repos/yuanrong-datasystem-ssd-hbm-direct}"
export L1_BUILD_DIR="${L1_BUILD_DIR:-/root/workspace/build-ssd-hbm-direct}"
# nodes.yaml xqyun thirdparty_cache — MUST set for builds (do not cold-download)
export DS_OPENSOURCE_DIR="${DS_OPENSOURCE_DIR:-/root/.cache/yuanrong-datasystem-third-party}"

# Local agent worktree
# /home/t14s/workspace/git-repos/yuanrong-datasystem/.worktrees/ssd-hbm-direct
# Branch: feat/ssd-hbm-direct  (rebase onto main/master before L2 runs)

# L2 NPU node (Stage A / B) — human fills
export L2_HOST="${L2_HOST:-user@npu-host}"
export L2_REPO="${L2_REPO:-/root/workspace/git-repos/yuanrong-datasystem}"
export L2_BUILD_DIR="${L2_BUILD_DIR:-/home/cache/build-remote-datasystem-npu}"

# Ascend / CANN (L2)
export ASCEND_HOME="${ASCEND_HOME:-/usr/local/Ascend/ascend-toolkit/latest}"
export LD_LIBRARY_PATH="${ASCEND_HOME}/lib64:${LD_LIBRARY_PATH:-}"

# NDS / xds (Stage B)
export BDEV_NAME="${BDEV_NAME:-/dev/nvme0n1}"
export XDS_SO_PATH="${XDS_SO_PATH:-}"
export P2P_DEVICE="${P2P_DEVICE:-/dev/p2p_device}"

# gtest filters
export BINMOCK_FILTER="${BINMOCK_FILTER:-NdsBinmockFlow*:HeteroD2HTest.*}"
export STAGE_A_FILTER="${STAGE_A_FILTER:-NdsStageA*}"
export STAGE_B_FILTER="${STAGE_B_FILTER:-NdsStageB*}"
